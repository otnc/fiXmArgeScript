{
  "name": "fixmarge",
  "displayName": "fiXmArge Script",
  "description": "fiXmArge Script (fxma) の色分け、診断、補完、整形。「魔法少女ノ魔女裁判」の非公式のファンメイド作品です。",
  "version": "0.0.0",
  "publisher": "otoneko1102",
  "author": "otoneko.",
  "license": "MIT OR Apache-2.0",
  "icon": "icon.png",
  "homepage": "https://github.com/otnc/fiXmArgeScript",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/otnc/fiXmArgeScript.git",
    "directory": "editors/vscode"
  },
  "engines": {
    "vscode": "^1.91.0"
  },
  "categories": ["Programming Languages", "Formatters", "Linters"],
  "main": "./extension.js",
  "contributes": {
    "languages": [
      {
        "id": "fxma",
        "aliases": ["fiXmArge Script", "fxma"],
        "extensions": [".fxma"],
        "configuration": "./fxma.language-configuration.json",
        "icon": { "light": "./icons/fxma.svg", "dark": "./icons/fxma.svg" }
      },
      {
        "id": "fxmac",
        "aliases": ["fiXmArge Script (清書)", "fxmac"],
        "extensions": [".fxmac"],
        "configuration": "./fxmac.language-configuration.json",
        "icon": { "light": "./icons/fxma.svg", "dark": "./icons/fxma.svg" }
      },
      {
        "id": "fxma-mod",
        "aliases": ["fiXmArge Script (fixmarge.mod)"],
        "filenames": ["fixmarge.mod"],
        "icon": { "light": "./icons/fxma-mod.svg", "dark": "./icons/fxma-mod.svg" }
      },
      {
        "id": "fxma-sum",
        "aliases": ["fiXmArge Script (fixmarge.sum)"],
        "filenames": ["fixmarge.sum"],
        "icon": { "light": "./icons/fxma-sum.svg", "dark": "./icons/fxma-sum.svg" }
      }
    ],
    "iconThemes": [
      {
        "id": "fxma-icons",
        "label": "fiXmArge Script のファイルアイコン (補助)",
        "path": "./icons/fxma-icon-theme.json"
      }
    ],
    "grammars": [
      {
        "language": "fxma",
        "scopeName": "source.fxma",
        "path": "./syntaxes/fxma.tmLanguage.json"
      },
      {
        "language": "fxmac",
        "scopeName": "source.fxmac",
        "path": "./syntaxes/fxmac.tmLanguage.json"
      },
      {
        "language": "fxma-mod",
        "scopeName": "source.fxma-mod",
        "path": "./syntaxes/fxma-mod.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "fiXmArge Script",
      "properties": {
        "fxma.path": {
          "type": "string",
          "default": "fixmarge",
          "markdownDescription": "言語サーバー (`fixmarge trench`) として動かす `fixmarge` の場所。既定では `PATH` から探します。"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "node build.mjs",
    "package": "vsce package"
  },
  "dependencies": {
    "vscode-languageclient": "^11.0.0"
  },
  "devDependencies": {
    "@vscode/vsce": "^4.0.0"
  }
}
