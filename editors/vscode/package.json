{
  "name": "fixmarge",
  "displayName": "fiXmArge Script",
  "description": "fiXmArge Script (fxma) の色分け、診断、補完、整形。「魔法少女ノ魔女裁判」の非公式のファンメイド作品です。",
  "version": "0.0.0",
  "publisher": "otoneko1102",
  "author": "otoneko.",
  "license": "MIT OR Apache-2.0",
  "icon": "icon.png",
  "homepage": "https://github.com/otnc/fiXmArgeScript",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/otnc/fiXmArgeScript.git",
    "directory": "editors/vscode"
  },
  "engines": {
    "vscode": "^1.91.0"
  },
  "categories": ["Programming Languages", "Formatters", "Linters"],
  "main": "./extension.js",
  "contributes": {
    "languages": [
      {
        "id": "fixmarge",
        "aliases": ["fiXmArge Script", "fixmarge"],
        "extensions": [".fxma"],
        "configuration": "./fixmarge.language-configuration.json",
        "icon": { "light": "./icons/fixmarge.svg", "dark": "./icons/fixmarge.svg" }
      },
      {
        "id": "fixmargec",
        "aliases": ["fiXmArge Script (清書)", "fixmargec"],
        "extensions": [".fxmac"],
        "configuration": "./fixmargec.language-configuration.json",
        "icon": { "light": "./icons/fixmarge.svg", "dark": "./icons/fixmarge.svg" }
      },
      {
        "id": "fixmarge-mod",
        "aliases": ["fiXmArge Script (fixmarge.mod)"],
        "filenames": ["fixmarge.mod"],
        "icon": { "light": "./icons/fixmarge-mod.svg", "dark": "./icons/fixmarge-mod.svg" }
      },
      {
        "id": "fixmarge-sum",
        "aliases": ["fiXmArge Script (fixmarge.sum)"],
        "filenames": ["fixmarge.sum"],
        "icon": { "light": "./icons/fixmarge-sum.svg", "dark": "./icons/fixmarge-sum.svg" }
      }
    ],
    "iconThemes": [
      {
        "id": "fixmarge-icons",
        "label": "fiXmArge Script のファイルアイコン (補助)",
        "path": "./icons/fixmarge-icon-theme.json"
      }
    ],
    "grammars": [
      {
        "language": "fixmarge",
        "scopeName": "source.fixmarge",
        "path": "./syntaxes/fixmarge.tmLanguage.json"
      },
      {
        "language": "fixmargec",
        "scopeName": "source.fixmargec",
        "path": "./syntaxes/fixmargec.tmLanguage.json"
      },
      {
        "language": "fixmarge-mod",
        "scopeName": "source.fixmarge-mod",
        "path": "./syntaxes/fixmarge-mod.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "fiXmArge Script",
      "properties": {
        "fixmarge.path": {
          "type": "string",
          "default": "fixmarge",
          "markdownDescription": "言語サーバー (`fixmarge trench`) として動かす `fixmarge` の場所。既定では `PATH` から探します。"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "node build.mjs",
    "package": "vsce package"
  },
  "dependencies": {
    "vscode-languageclient": "^11.0.0"
  },
  "devDependencies": {
    "@vscode/vsce": "^4.0.0"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  }
}
