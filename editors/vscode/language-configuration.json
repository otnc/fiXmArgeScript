{
  "comments": {
    "lineComment": "#"
  },
  "brackets": [
    ["(", ")"],
    ["[", "]"],
    ["{", "}"]
  ],
  "autoClosingPairs": [
    { "open": "(", "close": ")" },
    { "open": "[", "close": "]" },
    { "open": "{", "close": "}" },
    { "open": "\"", "close": "\"", "notIn": ["string"] }
  ],
  "surroundingPairs": [
    ["(", ")"],
    ["[", "]"],
    ["{", "}"],
    ["\"", "\""]
  ],
  "indentationRules": {
    "increaseIndentPattern": "^\s*((oqun|abiryoku|itsver)\s+)*(weho|curoi|mof|siva|teitance|youlugive|ennote|sentky)\b.*$|^.*\bazagara\s*(#.*)?$",
    "decreaseIndentPattern": "^\s*(finend|siva|youlugive|ennote)\b"
  }
}
