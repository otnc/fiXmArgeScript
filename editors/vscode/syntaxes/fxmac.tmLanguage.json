{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "fiXmArge Script (清書)",
  "scopeName": "source.fxmac",
  "patterns": [
    {
      "include": "#comment"
    },
    {
      "include": "#string"
    },
    {
      "include": "#number"
    },
    {
      "include": "#declaration"
    },
    {
      "include": "#constant"
    },
    {
      "include": "#operator-word"
    },
    {
      "include": "#keyword"
    },
    {
      "include": "#support"
    },
    {
      "include": "#call"
    },
    {
      "include": "#operator"
    }
  ],
  "repository": {
    "call": {
      "match": "([A-Za-z_]\\w*)(?=\\s*\\()",
      "captures": {
        "1": {
          "name": "entity.name.function.fxma"
        }
      }
    },
    "comment": {
      "name": "comment.line.number-sign.fxma",
      "match": "#.*$"
    },
    "constant": {
      "name": "constant.language.fxma",
      "match": "(?<![\\w'’~·-])(Vani·tA|TadACt|ULieSo)(?![\\w])"
    },
    "declaration": {
      "match": "(?<![\\w'’~·-])(We-Ho|cUrOi)(?![\\w])\\s+([A-Za-z_]\\w*)",
      "captures": {
        "1": {
          "name": "storage.type.function.fxma"
        },
        "2": {
          "name": "entity.name.function.fxma"
        }
      }
    },
    "escape": {
      "name": "constant.character.escape.fxma",
      "match": "\\\\(?:u\\{[0-9A-Fa-f]+\\}|.)"
    },
    "interpolation": {
      "name": "meta.interpolation.fxma",
      "begin": "#\\{",
      "end": "\\}",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.interpolation.begin.fxma"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.section.interpolation.end.fxma"
        }
      },
      "patterns": [
        {
          "include": "$self"
        }
      ]
    },
    "keyword": {
      "patterns": [
        {
          "name": "storage.modifier.fxma",
          "match": "(?<![\\w'’~·-])(AbiRyoku|showence|itsver|Oqun)(?![\\w])"
        },
        {
          "name": "keyword.control.fxma",
          "match": "(?<![\\w'’~·-])(AccUhEarts|zanfession|Tei-Tance|pray·lee|yOuLugiVe|CaNoSiri|En-NOte|ReDogh'|ShouBeK|aZaGara|sent-ky|FineNd|KetZen|meKaMo|Kei-P|itsWA|weRer|SiVa|aSte|Mof)(?![\\w])"
        }
      ]
    },
    "number": {
      "name": "constant.numeric.fxma",
      "match": "\\b\\d(?:_?\\d)*(?:\\.\\d(?:_?\\d)*)?(?:[eE][+-]?\\d+)?\\b"
    },
    "operator": {
      "name": "keyword.operator.fxma",
      "match": "\\*\\*|//|<<|>>|<=|>=|\\.\\.=?|[-+*/%<>&|^~]"
    },
    "operator-word": {
      "name": "keyword.operator.word.fxma",
      "match": "(?<![\\w'’~·-])(SeNaji|S~ond'|Batte|Iz'u|eXi'|N'o|Nii|Owk)(?![\\w])"
    },
    "string": {
      "patterns": [
        {
          "name": "string.quoted.triple.fxma",
          "begin": "\"\"\"",
          "end": "\"\"\"",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.fxma"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.fxma"
            }
          },
          "patterns": [
            {
              "include": "#escape"
            },
            {
              "include": "#interpolation"
            }
          ]
        },
        {
          "name": "string.quoted.double.fxma",
          "begin": "\"",
          "end": "\"",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.fxma"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.fxma"
            }
          },
          "patterns": [
            {
              "include": "#escape"
            },
            {
              "include": "#interpolation"
            }
          ]
        }
      ]
    },
    "support": {
      "patterns": [
        {
          "name": "support.function.fxma",
          "match": "(?<![\\w'’~·-])(i·zana-vitedeXi'|FinecloWtKuwPace|madRazysAnAnd|Iz'uKuwPace|Iz'udeFuTai|Lai NeiAlte|MEifKuwPace|BatteKolSu|Sen-choose|eATah·Guy|fOreSeNaji|Divil JIO|FinecloWt|PyusenS'e|Vani·Ell|Ligh-Luw|SodaKast|Sodagu-n|conf-Soy|rEcanRey|Commity|KuwPace|Lai Nei|RacDA-m|Say mAl|ShoJikA|deFuTai|madRazy|mu·Yon|sAiMoku|tSuYoNg|Matill|SaLook|YowEAk|ieyWOO|mOurce|nOzuki|sAgAin|sAnAnd|ChiDd|GoKuu|KolSu|Litto|Tarip|Zelln|nAddY|oNkhe|GoMi|Kast|SurC|gDie|gu-n|nAng|oRei|Ado|Eda|Edo|Hir|LEA)(?![\\w])"
        },
        {
          "name": "entity.name.namespace.fxma",
          "match": "(?<![\\w'’~·-])(i·zana-vited|ievil JIO|VariZaMa|dEstiMay|Coword|GE-mon|Memoid|KeyGa|MeMe|Toim)(?![\\w])"
        }
      ]
    }
  }
}
